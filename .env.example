DATABASE_URL=postgres://app:app@localhost:5432/tabletap
# Optional. Without it, events use an in-process bus (fine for a single server).
REDIS_URL=redis://localhost:6379
# At least 32 random characters: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string-please
# Public URL used when generating table QR codes
APP_URL=http://localhost:3000
